# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in. `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# Spotify (Now Spinning on /play)
#
# Setup, one time:
#   1. Go to https://developer.spotify.com/dashboard and create an app.
#   2. In the app settings, add this redirect URI:
#        http://127.0.0.1:3000/api/spotify/setup
#      (and your production URL when you deploy, e.g.
#        https://your-domain.com/api/spotify/setup)
#   3. Copy the Client ID and Client Secret into the two lines below.
#   4. With those filled in, run `npm run dev` and visit
#        http://127.0.0.1:3000/api/spotify/setup
#      You'll be redirected to Spotify, click Agree, then redirected back
#      with a refresh token displayed on the page. Paste that into
#      SPOTIFY_REFRESH_TOKEN below. That's it forever.
#
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Supabase (optional — leaderboards fall back to localStorage if unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
